<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LombokPDF</RootNamespace>
    <AssemblyName>LombokPDF</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LombokPDF</PackageId>
    <Version>1.0.0</Version>
    <Authors>Lombok Digital</Authors>
    <Company>Lombok Digital</Company>
    <Description>Lightweight, elegant, polyglot PDF generation — Apache 2.0</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://lombokpdf.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/codinglombok/lombokpdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;pdf-generation;html-to-pdf;invoice;report;i18n;rtl;wasm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="20.0.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.63" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="HandlebarsDotNet" Version="2.1.6" />
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
