{
  "name": "lombok/pdf",
  "description": "Lightweight, elegant PDF generation for PHP — Apache 2.0",
  "type": "library",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "authors": [
    { "name": "Lombok Digital", "email": "hello@codinglombok.dev", "homepage": "https://lombokpdf.dev" }
  ],
  "keywords": ["pdf", "pdf-generation", "html-to-pdf", "invoice", "report", "i18n", "rtl", "arabic", "cjk"],
  "homepage": "https://lombokpdf.dev",
  "support": {
    "issues": "https://github.com/codinglombok/lombokpdf/issues",
    "docs":   "https://docs.lombokpdf.dev"
  },
  "require": {
    "php":          ">=8.1",
    "ext-mbstring": "*",
    "ext-json":     "*",
    "ext-curl":     "*",
    "ext-intl":     "*",
    "symfony/yaml": "^7.1",
    "dompdf/dompdf": "^3.0"
  },
  "suggest": {
    "ext-ffi": "For the Stage 2 WASM LLE engine (full CSS Paged Media, HarfBuzz shaping)",
    "ext-imagick": "For rasterizing LombokCharts SVG output when embedding charts",
    "league/commonmark": "Required for the importMarkdown skill",
    "phpoffice/phpword": "Required for the importDocx skill",
    "setasign/fpdi": "Required for merge/split/watermark/compress ops skills and chart embedding",
    "setasign/fpdf": "Required alongside setasign/fpdi",
    "endroid/qr-code": "Required for the qrcode marks skill",
    "picqer/php-barcode-generator": "Required for the barcode marks skill"
  },
  "require-dev": {
    "phpunit/phpunit":            "^11.0",
    "phpstan/phpstan":            "^1.11",
    "squizlabs/php_codesniffer":  "^3.10",
    "rector/rector":              "^1.2",
    "league/commonmark":          "^2.5",
    "phpoffice/phpword":          "^1.2",
    "setasign/fpdi":              "^2.6",
    "setasign/fpdf":              "^1.8.6"
  },
  "autoload": {
    "psr-4": { "LombokPDF\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "LombokPDF\\Tests\\": "tests/" }
  },
  "scripts": {
    "test":   "phpunit --coverage-text",
    "stan":   "phpstan analyse src --level=9",
    "cs":     "phpcs src --standard=PSR12",
    "cs-fix": "phpcbf src --standard=PSR12",
    "rector": "rector process src"
  },
  "config": {
    "sort-packages":     true,
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable":     true
}
