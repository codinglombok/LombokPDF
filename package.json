{
  "name": "lombokpdf",
  "version": "1.0.0",
  "description": "Lightweight, elegant, polyglot PDF generation — Apache 2.0",
  "license": "Apache-2.0",
  "author": "Lombok Digital <hello@codinglombok.dev>",
  "homepage": "https://lombokpdf.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/lombokpdf.git"
  },
  "bugs": {
    "url": "https://github.com/codinglombok/lombokpdf/issues"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "html-to-pdf",
    "markdown-to-pdf",
    "css-paged-media",
    "invoice",
    "report",
    "template",
    "i18n",
    "rtl",
    "arabic",
    "cjk",
    "multilingual",
    "lightweight",
    "wasm",
    "apache2"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./skills": {
      "import": "./dist/skills/index.js",
      "require": "./dist/skills/index.cjs",
      "types": "./dist/skills/index.d.ts"
    },
    "./skills/io": {
      "import": "./dist/skills/io/index.js",
      "types": "./dist/skills/io/index.d.ts"
    },
    "./skills/ops": {
      "import": "./dist/skills/ops/index.js",
      "types": "./dist/skills/ops/index.d.ts"
    },
    "./skills/image": {
      "import": "./dist/skills/image/index.js",
      "types": "./dist/skills/image/index.d.ts"
    },
    "./skills/marks": {
      "import": "./dist/skills/marks/index.js",
      "types": "./dist/skills/marks/index.d.ts"
    },
    "./skills/forms": {
      "import": "./dist/skills/forms/index.js",
      "types": "./dist/skills/forms/index.d.ts"
    },
    "./skills/security": {
      "import": "./dist/skills/security/index.js",
      "types": "./dist/skills/security/index.d.ts"
    },
    "./skills/structure": {
      "import": "./dist/skills/structure/index.js",
      "types": "./dist/skills/structure/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./cli": "./dist/cli/index.js"
  },
  "bin": {
    "lombokpdf": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:wasm": "cd src/core && cargo build --target wasm32-unknown-unknown --release && wasm-bindgen",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "audit:security": "node scripts/audit-security.js",
    "audit:tokens": "node scripts/audit-tokens.js",
    "audit:sql": "node scripts/audit-sql.js",
    "audit:types": "tsc --noEmit --strict",
    "audit:licenses": "node scripts/audit-licenses.js",
    "audit:sbom": "node scripts/audit-sbom.js",
    "audit:all": "npm run audit:vendor && npm run audit:security && npm run audit:tokens && npm run audit:sql && npm run audit:types && npm run audit:licenses && npm run audit:sbom",
    "docs": "typedoc src/index.ts",
    "prepublishOnly": "npm run audit:all && npm run build && npm test",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "audit:vendor": "node scripts/check-vendor.mjs"
  },
  "dependencies": {
    "@types/hyphen": "^1.14.0",
    "bidi-js": "^1.0.3",
    "handlebars": "^4.7.8",
    "hyphen": "^1.14.1",
    "jsbarcode": "^3.11.6",
    "lombokqrcode": "^0.2.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@lombok/charts": ">=1.0.0",
    "@lombok/css": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@lombok/css": {
      "optional": true
    },
    "@lombok/charts": {
      "optional": true
    }
  }
}
